{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flox: Debug Frontend",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "Flox: Start"
    },
    {
      "name": "Flox: Debug Backend",
      "type": "java",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005,
      "preLaunchTask": "Flox: Start"
    }
  ]
}